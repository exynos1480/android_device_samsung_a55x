hal_client_domain(hal_graphics_composer_default,hal_graphics_allocator)
set_prop(hal_graphics_composer_default, vendor_hwc_prop)
vndbinder_use(hal_graphics_composer_default)

r_dir_file(hal_graphics_composer_default, sysfs_gpu)
r_dir_file(hal_graphics_composer_default, sysfs_lcd_writable)
r_dir_file(hal_graphics_composer_default, sysfs_backlight_writable)

allow hal_graphics_composer_default log_vendor_data_file:dir create_dir_perms;
allow hal_graphics_composer_default log_vendor_data_file:file create_file_perms;
allow hal_graphics_composer_default gpu_device:chr_file rw_file_perms;
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket { bind create read };
allow hal_graphics_composer_default sysfs_backlight_writable:file { getattr open read write };
