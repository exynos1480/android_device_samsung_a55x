r_dir_file(init, sysfs_block)

allow init efs_file:dir mounton;
allow init mnt_vendor_file:dir mounton;
allow init ram_device:blk_file write;
allow init sec_efs_file:dir mounton;
allow init sysfs_block_writable:file rw_file_perms;
allow init tmpfs:lnk_file create;
allow init vendor_firmware_file:file mounton;

allow init {
    boot_block_device
    custom_ab_block_device
    vbmeta_block_device
}:{ blk_file lnk_file } relabelto;
