attribute hal_hermes;
attribute hal_hermes_server;
attribute hal_hermes_client;

type hal_hermes_service, service_manager_type;

type hal_hermes_default, domain;
type hal_hermes_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_hermes_default)
hal_server_domain(hal_hermes_default, hal_hermes)

binder_use(hal_hermes_default)
binder_call(hal_hermes_default, servicemanager)

add_service(hal_hermes_default, hal_hermes_service)

unix_socket_connect(hal_hermes_default, hermes, hermesd)
binder_call(system_server, hal_hermes_default)
binder_call(hal_hermes_default, hermesd)

allow hal_hermes_default log_vendor_data_file:dir rw_dir_perms;
allow hal_hermes_default log_vendor_data_file:file create_file_perms;
