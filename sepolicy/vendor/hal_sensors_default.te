allow hal_sensors_default app_efs_file:file create_file_perms;
allow hal_sensors_default efs_file:dir create_dir_perms;
allow hal_sensors_default efs_file:file create_file_perms;
allow hal_sensors_default sysfs:dir r_dir_perms;

# Hide denial of setting persist.sns.camera_light which is unused on AOSP
dontaudit hal_sensors_default default_prop:property_service set;
dontaudit hal_sensors_default property_socket:sock_file rw_file_perms;
