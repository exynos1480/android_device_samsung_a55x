binder_call(hal_sensors_default, system_server)
allow hal_sensors_default sysfs:file r_file_perms;
allow hal_sensors_default persist_file:dir { search add_name write };
allow hal_sensors_default persist_file:file create_file_perms;
allow hal_sensors_default persist_file:dir remove_name;
dontaudit hal_sensors_default property_socket:sock_file write;
