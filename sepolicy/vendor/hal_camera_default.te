hal_client_domain(hal_camera_default, hal_graphics_allocator)
hal_client_domain(hal_camera_default, hal_graphics_composer)
hal_client_domain(hal_camera_default, hal_thermal)

binder_call(hal_camera_default, system_server)
binder_call(system_server, hal_camera_default)

r_dir_file(hal_camera_default, app_efs_file)
r_dir_file(hal_camera_default, efs_file)
r_dir_file(hal_camera_default, proc_meminfo)
r_dir_file(hal_camera_default, sysfs_battery)
r_dir_file(hal_camera_default, sysfs_camera_writable)
r_dir_file(hal_camera_default, sysfs_camera)
r_dir_file(hal_camera_default, sysfs_gpu)
r_dir_file(hal_camera_default, sysfs_sensors)

allow hal_camera_default dmabuf_camera_heap_device:chr_file r_file_perms;
allow hal_camera_default sysfs_camera_writable:file w_file_perms;
dontaudit hal_camera_default default_prop:file r_file_perms;
dontaudit hal_camera_default persist_debug_prop:file r_file_perms;
get_prop(hal_camera_default, exported_camera_prop)
set_prop(hal_camera_default, vendor_camera_prop)
