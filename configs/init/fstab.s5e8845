# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#<src>                                      <mnt_point>       <type>    <mnt_flags and options>            <fs_mgr_flags>
system                                      /system           ext4      noatime,ro                         slotselect,wait,logical,first_stage_mount
system_ext                                  /system_ext       ext4      noatime,ro                         slotselect,wait,logical,first_stage_mount
vendor                                      /vendor           erofs     ro                                 slotselect,wait,logical,first_stage_mount
vendor_dlkm                                 /vendor_dlkm      erofs     ro                                 slotselect,wait,logical,first_stage_mount
system_dlkm                                 /system_dlkm      erofs     ro                                 slotselect,wait,logical,first_stage_mount
product                                     /product          ext4      noatime,ro                         slotselect,wait,logical,first_stage_mount
odm                                         /odm              ext4      noatime,ro                         slotselect,wait,logical,first_stage_mount
/dev/block/by-name/boot                     /boot             emmc      defaults                           slotselect,first_stage_mount,formattable
/dev/block/by-name/init_boot                /init_boot        emmc      defaults                           slotselect,first_stage_mount,formattable
/dev/block/by-name/vendor_boot              /vendor_boot      emmc      defaults                           slotselect,first_stage_mount,formattable
/dev/block/by-name/dtbo                     /dtbo             emmc      defaults                           slotselect,first_stage_mount,formattable
/dev/block/by-name/vbmeta                   /vbmeta           emmc      defaults                           slotselect,first_stage_mount,formattable
/dev/block/by-name/vbmeta_system            /vbmeta_system    emmc      defaults                           slotselect,first_stage_mount,formattable
/dev/block/by-name/metadata                 /metadata         f2fs      noatime,nosuid,nodev,discard,sync,fsync_mode=strict,data_flush  wait,formattable,first_stage_mount,check
/dev/block/by-name/userdata                 /data             f2fs      noatime,nosuid,nodev,discard,usrquota,grpquota,fsync_mode=nobarrier,reserve_root=32768,resgid=5678,inlinecrypt  latemount,wait,check,quota,checkpoint=fs,reservedsize=128M,fscompress,ddp,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0,metadata_encryption=aes-256-xts:wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption
/dev/block/by-name/efs                      /mnt/vendor/efs   ext4      noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic  wait,formattable,check
/dev/block/by-name/cpefs                    /mnt/vendor/cpefs ext4      noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic  wait,check,nofail
/dev/block/by-name/misc                     /misc             emmc      defaults                           defaults,first_stage_mount
/dev/block/by-name/cache                    /cache            ext4      noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic  wait,formattable,check
/dev/block/by-name/slotinfo                 /slotinfo         emmc      defaults                           defaults

# Zram
/dev/block/zram0                            none              swap      defaults                           zramsize=30%

# VOLD
/devices/platform/13200000.usb*             auto              vfat      default                            voldmanaged=usb:auto
/devices/platform/12be0000.dwmmc2/mmc_host* auto              auto      default                            voldmanaged=sdcard:auto,encryptable=userdata
