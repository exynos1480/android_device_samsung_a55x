cc_binary {
    name: "android.hardware.vibrator-service.s5e8845",
    relative_install_path: "hw",
    init_rc: ["android.hardware.vibrator-service.s5e8845.rc"],
    vintf_fragments: ["android.hardware.vibrator-service.s5e8845.xml"],
    cppflags: select(soong_config_variable("samsungVibratorVars", "duration_amplitude"), {
        true: ["-DVIBRATOR_SUPPORTS_DURATION_AMPLITUDE_CONTROL"],
        default: [],
    }),
    srcs: [
        "Vibrator.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.vibrator-V2-ndk",
    ],
    vendor: true,
}
