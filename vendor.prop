## Adoptable Storage
ro.crypto.volume.options=aes-256-xts:aes-256-cts:v2

## APK Verity
ro.apk_verity.mode=2

## Keystore
ro.hardware.keystore_desede=true

## Audio
aaudio.mmap_policy=2
aaudio.mmap_exclusive_policy=2
aaudio.hw_burst_min_usec=2000
ro.audio.spatializer_enabled=true
audio.offload.min.duration.secs=30

## Dalvik
dalvik.vm.dex2oat64.enabled=true
dalvik.vm.lockprof.threshold=500

## FRP
ro.frp.pst=/dev/block/persistent

## FUSE
persist.sys.fuse.passthrough.enable=true

## Graphics
debug.sf.auto_latch_unsignaled=0
debug.sf.disable_client_composition_cache=1
debug.sf.show_refresh_rate_overlay_render_rate=true
debug.sf.treat_170m_as_sRGB=1
debug.sf.predict_hwc_composition_strategy=0
debug.sf.use_phase_offsets_as_durations=1
debug.sf.late.sf.duration=10500000
debug.sf.late.app.duration=16600000
debug.sf.early.sf.duration=16600000
debug.sf.early.app.duration=16600000
debug.sf.earlyGl.sf.duration=16600000
debug.sf.earlyGl.app.duration=16600000
persist.sys.sf.color_saturation=1.0
ro.hardware.egl=angle
ro.hardware.vulkan=samsung
ro.opengles.version=196610

## Display
ro.surface_flinger.enable_frame_rate_override=false
ro.surface_flinger.set_display_power_timer_ms=200
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.has_HDR_display=true
ro.surface_flinger.has_wide_color_display=true
ro.surface_flinger.protected_contents=true
ro.surface_flinger.running_without_sync_framework=false
ro.surface_flinger.set_idle_timer_ms=1000
ro.surface_flinger.set_touch_timer_ms=1000
ro.surface_flinger.set_display_power_timer_ms=200
ro.surface_flinger.use_content_detection_for_refresh_rate=true
vendor.hwc.exynos.vsync_mode=0
vendor.hwc.drm.device=/dev/dri/card1

## GPU
ro.egl.blobcache.multifile=true
ro.egl.blobcache.multifile_limit=536870912

## Incremental FS
ro.incremental.enable=true

## Camera
ro.camera.disableJpegR=true

## Media
debug.stagefright.c2inputsurface=-1
vendor.debug.c2.sbwc.enable=false
debug.stagefright.ccodec_strict_type=true
debug.stagefright.ccodec_lax_type=true
debug.stagefright.c2-poolmask=458752
media.c2.dmabuf.padding=512
debug.c2.use_dmabufheaps=1
debug.stagefright.ccodec_delayed_params=1
ro.vendor.gpu.dataspace=1

## Metadata Encryption
ro.crypto.dm_default_key.options_format.version=2
# Call deleteAllKeys if vold detects a factory reset
ro.crypto.metadata_init_delete_all_keys.enabled=true
ro.crypto.volume.metadata.method=dm-default-key

## Power HAL
vendor.powerhal.disp.idle_support=false

## Zygote
zygote.critical_window.minute=10

## Samsung specific
ro.product_ship=true
# Set csc support in OMX
# If not set or set to 0, OMX will only use BT.601 colorspace.
ro.vendor.cscsupported=1

## SoC
ro.soc.manufacturer=Samsung
ro.soc.model=Exynos 1480

## Fingerprint
ro.vendor.fingerprint.type=udfps_optical
ro.vendor.fingerprint.force_calibrate=1
ro.vendor.fingerprint.request_touch_event=true
ro.vendor.fingerprint.sensor_location=540|2055|118

## Bluetooth
bluetooth.device.class_of_device=90,2,12
bluetooth.profile.asha.central.enabled=true
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.avrcp.target.enabled=true
bluetooth.profile.bap.broadcast.source.enabled=false
bluetooth.profile.hfp.ag.enabled=true
bluetooth.profile.hid.device.enabled=true
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.map.server.enabled=true
bluetooth.profile.opp.enabled=false
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.pan.panu.enabled=true
bluetooth.profile.pbap.server.enabled=true
bluetooth.profile.sap.server.enabled=true
bluetooth.profile.a2dp.sink.enabled=false
bluetooth.profile.avrcp.controller.enabled=false
bluetooth.profile.bap.unicast.client.enabled=true
bluetooth.profile.csip.set_coordinator.enabled=true
bluetooth.profile.mcp.server.enabled=true
bluetooth.profile.ccp.server.enabled=true
bluetooth.profile.vcp.controller.enabled=true
bluetooth.profile.bap.broadcast.assist.enabled=true
bluetooth.profile.hap.client.enabled=true
bluetooth.profile.bas.client.enabled=true

## Wi-Fi
wifi.direct.interface=p2p0
ro.boot.wificountrycode=00

## NFC
ro.vendor.nfc.feature.chipname=SLSI

# Codec2
media.c2.hal.selection=aidl

## LKMD
ro.lmk.filecache_min_kb=153600
ro.lmk.kill_timeout_ms=50
ro.lmk.psi_partial_stall_ms=70
ro.lmk.psi_complete_stall_ms=700
ro.lmk.thrashing_limit=100
ro.lmk.thrashing_limit_decay=10
ro.lmk.stall_limit_critical=40
ro.lmk.swap_free_low_percentage=100

## RIL
ro.carrier=unknown
ro.radio.noril=no
vendor.rild.libpath=/vendor/lib64/libsec-ril.so
vendor.sec.rild.libpath=/vendor/lib64/libsec-ril.so
